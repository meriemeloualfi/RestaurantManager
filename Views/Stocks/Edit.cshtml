@model RestaurantManager.Models.Ingredient

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modifier Ingrédient - Food Dash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .main-content {
            background-color: #f4f7fa;
            padding: 40px !important;
        }

        .edit-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .master-card-edit {
            background: white;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        .edit-header {
            padding: 35px 50px;
            background: #ffffff;
            border-bottom: 1px solid #f1f5f9;
        }

            .edit-header h2 {
                font-weight: 700;
                color: #0f172a;
                margin: 0;
            }

        .edit-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 0;
        }

        .form-section {
            padding: 50px;
            border-right: 1px solid #f1f5f9;
        }

        .preview-section {
            padding: 50px;
            background-color: #fafbfc;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }

        .custom-input {
            border-radius: 12px;
            padding: 12px 18px;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            transition: 0.3s;
            font-weight: 500;
        }

            .custom-input:focus {
                background-color: #fff;
                border-color: #ff7b2e;
                box-shadow: 0 0 0 4px rgba(255, 123, 46, 0.1);
                outline: none;
            }

        .current-image-wrapper {
            width: 100%;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            margin-bottom: 25px;
            background: #fff;
            aspect-ratio: 4/3;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .current-image-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .edit-actions {
            padding: 30px 50px;
            background: #ffffff;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-save-pro {
            background: #0f172a;
            color: white;
            padding: 14px 40px;
            border-radius: 14px;
            font-weight: 600;
            border: none;
            transition: 0.3s;
            cursor: pointer;
        }

            .btn-save-pro:hover {
                background: #ff7b2e;
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 123, 46, 0.2);
            }

        .btn-cancel-pro {
            color: #64748b;
            text-decoration: none;
            font-weight: 600;
            transition: 0.2s;
        }

            .btn-cancel-pro:hover {
                color: #0f172a;
            }

        .input-icon-group {
            position: relative;
        }
    </style>
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h3 class="fw-bold mb-5">Food Dash <span class="text-orange-resto">.</span> </h3>
            <nav class="nav flex-column">
                <a class="nav-link" href="/Gerant"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a class="nav-link" href="/Plats"><i class="fa-solid fa-burger"></i> Menu / Plats</a>
                <a class="nav-link" href="/Employes"><i class="fa-solid fa-users"></i> Personnel</a>
                <a class="nav-link" href="/Reservations"><i class="fa-solid fa-calendar-check"></i> Réservations</a>
                <a class="nav-link active" href="/Stocks"><i class="fa-solid fa-box"></i> Stocks</a>
                <a class="nav-link" href="/Ventes"><i class="fa-solid fa-chart-line"></i> Ventes</a>

                <!-- Cette section doit être la DERNIÈRE à l'intérieur de votre <nav> -->
                <div class="logout-section">
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="bg-transparent border-0 btn-logout text-start">
                            <i class="fa-solid fa-power-off me-2"></i> Déconnexion
                        </button>
                    </form>
                </div>
            </nav>
        </div>

        <div class="main-content">
            <div class="edit-container">
                <div class="mb-4">
                    <a asp-action="Index" class="text-muted text-decoration-none small fw-bold">
                        <i class="fa-solid fa-chevron-left me-1"></i> Retour au stock
                    </a>
                </div>

                <div class="master-card-edit">
                    <div class="edit-header">
                        <h2>Modifier l'ingrédient : <span class="text-orange-resto">@Model.Nom</span></h2>
                    </div>

                    <form asp-action="Edit" enctype="multipart/form-data" id="editForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="IdIngredient" />
                        <input type="hidden" asp-for="ImagePath" />

                        <div class="edit-grid">
                            <!-- SECTION FORMULAIRE -->
                            <div class="form-section">
                                <div class="mb-4">
                                    <label asp-for="Nom" class="form-label">Désignation de l'ingrédient</label>
                                    <input asp-for="Nom" class="form-control custom-input" placeholder="Ex: Farine de blé" />
                                    <span asp-validation-for="Nom" class="text-danger small"></span>
                                </div>

                                <div class="row mb-4">
                                    <div class="col-md-6">
                                        <label asp-for="QuantiteDisponible" class="form-label">Quantité en Stock</label>
                                        <input asp-for="QuantiteDisponible" class="form-control custom-input" type="number" step="0.1" />
                                        <span asp-validation-for="QuantiteDisponible" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6">
                                        <label asp-for="Unite" class="form-label">Unité de mesure</label>
                                        <select asp-for="Unite" class="form-control custom-input">
                                            <option value="kg">kilogramme (kg)</option>
                                            <option value="L">Litre (L)</option>
                                            <option value="Unité">Unité (pcs)</option>
                                            <option value="g">Gramme (g)</option>
                                        </select>
                                        <span asp-validation-for="Unite" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="mb-0">
                                    <label asp-for="SeuilAlerte" class="form-label">Seuil d'Alerte (Stock Critique)</label>
                                    <input asp-for="SeuilAlerte" class="form-control custom-input" type="number" step="0.1" />
                                    <span asp-validation-for="SeuilAlerte" class="text-danger small"></span>
                                    <p class="text-muted small mt-2">Une notification apparaîtra si le stock descend sous ce niveau.</p>
                                </div>
                            </div>

                            <!-- SECTION PREVIEW IMAGE -->
                            <div class="preview-section">
                                <label class="form-label">Visuel Produit</label>
                                <div class="current-image-wrapper">
                                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                                    {
                                        <img src="~/images/ingredients/@Model.ImagePath" alt="Aperçu" id="imgPreview" />
                                    }
                                    else
                                    {
                                        <div class="text-center p-4">
                                            <i class="fa-solid fa-box-open fa-4x text-muted opacity-25 mb-3"></i>
                                            <img src="" id="imgPreview" style="display:none;" />
                                        </div>
                                    }
                                </div>

                                <label class="form-label">Mettre à jour la photo</label>
                                <div class="input-group">
                                    <input type="file" name="imageFile" id="imageInput" class="form-control custom-input border-dashed" accept="image/*" onchange="previewImage(this)" />
                                </div>
                                <p class="text-muted small mt-2 text-center">Formats acceptés : JPG, PNG, WebP</p>
                            </div>
                        </div>

                        <div class="edit-actions">
                            <a asp-action="Index" class="btn-cancel-pro">Annuler l'édition</a>
                            <button type="submit" class="btn-save-pro shadow-lg">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Enregistrer les modifications
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var img = document.getElementById('imgPreview');
                    img.src = e.target.result;
                    img.style.display = 'block';
                    // Si c'était l'icône placeholder, on s'assure que l'image remplit le wrapper
                    img.closest('.current-image-wrapper').innerHTML = '<img src="' + e.target.result + '" id="imgPreview" />';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>