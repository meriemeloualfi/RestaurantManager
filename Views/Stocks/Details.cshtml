@model RestaurantManager.Models.Ingredient
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Détails Ingrédient | Food Dash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        .main-content {
            background-color: #f8fafc;
            padding: 40px !important;
        }

        .details-master-card {
            background: white;
            border-radius: 32px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 40px rgba(0,0,0,0.03);
            max-width: 900px;
            margin: 0 auto;
            overflow: hidden;
        }

        /* --- HEADER --- */
        .details-header {
            padding: 40px 50px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(to right, #ffffff, #fafbfc);
        }

        .status-badge-lg {
            padding: 10px 25px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 700;
        }

        .status-ok {
            background: #dcfce7;
            color: #15803d;
            border: 1px solid #bbf7d0;
        }

        .status-alert {
            background: #fef2f2;
            color: #ef4444;
            border: 1px solid #fee2e2;
        }

        /* --- CONTENT --- */
        .details-body {
            padding: 50px;
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 50px;
        }

        .img-container-det {
            width: 100%;
            height: 300px;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 15px 35px rgba(0,0,0,0.05);
            background: #f1f5f9;
        }

            .img-container-det img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .info-group-det {
            margin-bottom: 25px;
        }

        .info-label-det {
            font-size: 0.75rem;
            font-weight: 700;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 1px;
            display: block;
            margin-bottom: 8px;
        }

        .info-value-det {
            font-size: 1.2rem;
            font-weight: 600;
            color: #1e293b;
        }

        .metric-card {
            background: #f8fafc;
            padding: 20px;
            border-radius: 18px;
            border: 1px solid #eff2f5;
            text-align: center;
        }

        /* --- FOOTER & BUTTONS CORRIGÉS --- */
        .details-footer {
            padding: 30px 50px;
            background: #f8fafc;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between; /* Aligne Supprimer à gauche et Modifier à droite */
            align-items: center;
        }

        .btn-delete-pro {
            color: #94a3b8;
            font-weight: 600;
            text-decoration: none;
            padding: 12px 18px;
            border-radius: 12px;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

            .btn-delete-pro:hover {
                background: #fee2e2;
                color: #ef4444;
            }

        .btn-edit-pro {
            background: #1e293b;
            color: white;
            padding: 12px 28px;
            border-radius: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            border: none;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

            .btn-edit-pro:hover {
                background: #fb923c; /* Orange au survol */
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 10px 15px -3px rgba(251, 146, 60, 0.2);
            }
    </style>
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h3 class="fw-bold mb-5">Food Dash <span class="text-orange-resto">.</span> </h3>
            <nav class="nav flex-column">
                <a class="nav-link" href="/Gerant"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a class="nav-link" href="/Plats"><i class="fa-solid fa-burger"></i> Menu / Plats</a>
                <a class="nav-link" href="/Employes"><i class="fa-solid fa-users"></i> Personnel</a>
                <a class="nav-link" href="/Reservations"><i class="fa-solid fa-calendar-check"></i> Réservations</a>
                <a class="nav-link active" href="/Stocks"><i class="fa-solid fa-box"></i> Stocks</a>
                <a class="nav-link" href="/Ventes"><i class="fa-solid fa-chart-line"></i> Ventes</a>
                <!-- Cette section doit être la DERNIÈRE à l'intérieur de votre <nav> -->
                <div class="logout-section">
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="bg-transparent border-0 btn-logout text-start">
                            <i class="fa-solid fa-power-off me-2"></i> Déconnexion
                        </button>
                    </form>
                </div>
            </nav>
        </div>

        <div class="main-content">
            <div class="mb-4">
                <a asp-action="Index" class="text-muted text-decoration-none fw-bold small">
                    <i class="fa-solid fa-arrow-left me-2"></i> RETOUR AU STOCK
                </a>
            </div>

            <div class="details-master-card">
                <div class="details-header">
                    <div>
                        <span class="info-label-det">Fiche Ingrédient</span>
                        <h1 class="fw-bold mb-0">@Model.Nom</h1>
                    </div>
                    @{
                        var isLow = Model.QuantiteDisponible <= Model.SeuilAlerte;
                    }
                    @* Vocabulaire amélioré ici *@
                    <div class="status-badge-lg @(isLow ? "status-alert" : "status-ok")">
                        <i class="fa-solid @(isLow ? "fa-triangle-exclamation" : "fa-check-circle") me-2"></i>
                        @(isLow ? "STOCK CRITIQUE" : "STOCK OPTIMAL")
                    </div>
                </div>

                <div class="details-body">
                    <!-- IMAGE -->
                    <div class="img-container-det">
                        @if (!string.IsNullOrEmpty(Model.ImagePath))
                        {
                            <img src="~/images/ingredients/@Model.ImagePath" alt="@Model.Nom" />
                        }
                        else
                        {
                            <div class="h-100 w-100 d-flex align-items-center justify-content-center">
                                <i class="fa-solid fa-box fa-4x text-muted opacity-25"></i>
                            </div>
                        }
                    </div>

                    <!-- INFOS -->
                    <div>
                        <div class="row g-3 mb-4">
                            <div class="col-6">
                                <div class="metric-card">
                                    <span class="info-label-det">Quantité en stock</span>
                                    <div class="info-value-det text-orange-resto">@Model.QuantiteDisponible @Model.Unite</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="metric-card">
                                    <span class="info-label-det">Seuil d'alerte</span>
                                    <div class="info-value-det">@Model.SeuilAlerte @Model.Unite</div>
                                </div>
                            </div>
                        </div>

                        <div class="info-group-det">
                            <span class="info-label-det">Unité de gestion</span>
                            <div class="info-value-det">Mesure en @Model.Unite</div>
                        </div>

                        <div class="info-group-det">
                            <span class="info-label-det">Dernière mise à jour</span>
                            <div class="info-value-det small text-muted">@DateTime.Now.ToString("dd MMMM yyyy à HH:mm")</div>
                        </div>
                    </div>
                </div>

                @* Pied de page corrigé et aligné *@
                <div class="details-footer">
                    <a asp-action="Delete" asp-route-id="@Model.IdIngredient" class="btn-delete-pro">
                        <i class="fa-solid fa-trash-can me-2"></i> SUPPRIMER CET INGRÉDIENT
                    </a>

                    <a asp-action="Edit" asp-route-id="@Model.IdIngredient" class="btn-edit-pro">
                        <i class="fa-solid fa-pen-to-square me-2"></i> Modifier la fiche
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>