@model IEnumerable<RestaurantManager.Models.Ingredient>
@{
    Layout = null;
    // Calcul du nombre de produits en alerte
    int nbAlertes = Model.Count(i => i.QuantiteDisponible <= i.SeuilAlerte);
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Cuisine Pro | Food Dash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            /* Couleurs de l'index pour la sidebar */
            --primary-orange: #ff7b2e;
            --dark-blue: #1e293b;
            --light-bg: #f1f5f9;
            --primary-grad: linear-gradient(135deg, #ff7b2e 0%, #ff5e00 100%);
            --card-bg: #ffffff;
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Poppins', sans-serif;
            color: var(--dark-blue);
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* --- SIDEBAR STYLE DE L'INDEX --- */
        .sidebar {
            width: 280px;
            background: var(--dark-blue);
            color: white;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
            z-index: 1000;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.7);
                padding: 12px 20px;
                border-radius: 12px;
                margin-bottom: 8px;
                transition: 0.3s;
                display: flex;
                align-items: center;
                text-decoration: none;
            }

                .sidebar .nav-link i {
                    margin-right: 15px;
                    width: 20px;
                    text-align: center;
                }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: var(--primary-orange);
                    color: white;
                    box-shadow: 0 4px 15px rgba(255, 123, 46, 0.3);
                }

        .text-orange-resto {
            color: var(--primary-orange);
        }

        /* --- CONTENU PRINCIPAL --- */
        .main-content {
            margin-left: 280px;
            flex-grow: 1;
            padding: 40px;
        }

        /* Card Design */
        .ing-card {
            background: var(--card-bg);
            border-radius: 30px;
            border: none;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
            transition: 0.4s;
            height: 100%;
        }

            .ing-card:hover {
                transform: translateY(-15px);
                box-shadow: 0 30px 60px rgba(0,0,0,0.1);
            }

        .ing-image-wrapper {
            height: 180px;
            position: relative;
            overflow: hidden;
        }

        .ing-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.5s;
        }

        .ing-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            padding: 20px;
            color: white;
        }

        .ing-status {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 8px 15px;
            border-radius: 12px;
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            backdrop-filter: blur(10px);
        }

        .status-ok {
            background: rgba(34, 197, 94, 0.9);
            color: white;
        }

        .status-low {
            background: rgba(239, 68, 68, 0.9);
            color: white;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0% {
                opacity: 1;
            }

            50% {
                opacity: 0.7;
            }

            100% {
                opacity: 1;
            }
        }

        .ing-body {
            padding: 25px;
        }

        .stock-display {
            display: flex;
            align-items: baseline;
            gap: 10px;
            margin-bottom: 15px;
        }

        .stock-number {
            font-size: 2rem;
            font-weight: 800;
            color: var(--dark-blue);
        }

        .stock-unit {
            color: #64748b;
            font-weight: 600;
        }

        .progress-custom {
            height: 10px;
            background: #e2e8f0;
            border-radius: 20px;
            margin-bottom: 25px;
        }

        .progress-fill {
            height: 100%;
            border-radius: 20px;
            background: var(--primary-grad);
        }

        .action-zone {
            background: #f8fafc;
            border-radius: 20px;
            padding: 15px;
        }

        .quick-actions {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
        }

        .btn-qty {
            flex: 1;
            border: 1px solid #cbd5e1;
            background: white;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 600;
            transition: 0.2s;
        }

            .btn-qty:hover {
                background: var(--dark-blue);
                color: white;
            }

        .qty-input-modern {
            border: 2px solid #e2e8f0;
            border-radius: 15px;
            text-align: center;
            font-weight: 700;
            height: 45px;
            margin-bottom: 10px;
        }

        .btn-submit-modern {
            width: 100%;
            background: var(--dark-blue);
            color: white;
            border: none;
            height: 45px;
            border-radius: 15px;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-submit-modern:hover {
                background: var(--primary-orange);
                box-shadow: 0 10px 20px rgba(255, 123, 46, 0.3);
            }

        .btn-details-top {
            position: absolute;
            top: 15px;
            left: 15px;
            width: 35px;
            height: 35px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(5px);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            text-decoration: none;
        }

        .alert-counter {
            background: white;
            padding: 15px 25px;
            border-radius: 18px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 700;
        }

            .alert-counter i {
                font-size: 1.5rem;
            }

            .alert-counter .count {
                font-size: 1.8rem;
            }

            .alert-counter .label {
                font-size: 0.8rem;
                text-transform: uppercase;
                opacity: 0.7;
            }

        .alert-on {
            color: #ef4444;
        }

        .alert-off {
            color: #22c55e;
        }
        /* Désactiver le hover uniquement pour le bouton Déconnexion */
        .sidebar form .nav-link:hover {
            background: transparent !important;
            color: rgba(255,255,255,0.7) !important;
            box-shadow: none !important;
        }


    </style>
</head>
<body>

    <div class="admin-wrapper">
        <!-- SIDEBAR DE L'INDEX -->
        <div class="sidebar">
            <h3 class="fw-bold mb-5">Food Dash <span class="text-orange-resto">.</span> </h3>
            <nav class="nav flex-column h-100">
                <a class="nav-link" asp-controller="Cuisinier" asp-action="Index">
                    <i class="fa-solid fa-fire-burner"></i> Dashboard
                </a>
                <a class="nav-link" asp-controller="Cuisinier" asp-action="Taches">
                    <i class="fa-solid fa-list-check"></i> Mes Tâches
                </a>
                <a class="nav-link active" asp-controller="Cuisinier" asp-action="Stock">
                    <i class="fa-solid fa-boxes-stacked"></i> Stock
                </a>

                <!-- Cette section doit être la DERNIÈRE à l'intérieur de votre <nav> -->
                <div class="logout-section">
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="bg-transparent border-0 btn-logout text-start">
                            <i class="fa-solid fa-power-off me-2"></i> Déconnexion
                        </button>
                    </form>
                </div>
            </nav>
        </div>

        <div class="main-content">
            <!-- HEADER AVEC COMPTEUR D'ALERTE -->
            <div class="d-flex justify-content-between align-items-end mb-5">
                <div>
                    <h1 class="fw-bold mb-0">Inventaire <span class="text-orange-resto">Cuisine</span></h1>
                    <p class="text-muted">Gérez vos ingrédients en temps réel.</p>
                </div>
                <div class="alert-counter @(nbAlertes > 0 ? "alert-on" : "alert-off")">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span class="count">@nbAlertes</span>
                    <span class="label">Produits en alerte</span>
                </div>

            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var item in Model)
                {
                    var isLow = item.QuantiteDisponible <= item.SeuilAlerte;
                    float percentage = (float)((item.QuantiteDisponible / (item.SeuilAlerte * 4)) * 100);
                    if (percentage > 100) percentage = 100;

                    <div class="col">
                        <div class="ing-card">
                            <div class="ing-image-wrapper">
                                <a asp-action="Details" asp-route-id="@item.IdIngredient" class="btn-details-top">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <div class="ing-status @(isLow ? "status-low" : "status-ok")">
                                    @(isLow ? "Alerte Stock" : "En Stock")
                                </div>
                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="~/images/ingredients/@item.ImagePath" class="ing-image" alt="@item.Nom">
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-secondary d-flex align-items-center justify-content-center text-white">
                                        <i class="fa-solid fa-bowl-food fa-3x"></i>
                                    </div>
                                }
                                <div class="ing-overlay">
                                    <h4 class="fw-bold mb-0">@item.Nom</h4>
                                </div>
                            </div>

                            <div class="ing-body">
                                <div class="stock-display">
                                    <span class="stock-number">@item.QuantiteDisponible</span>
                                    <span class="stock-unit">@item.Unite</span>
                                </div>

                                <div class="progress-custom">
                                    <div class="progress-fill" style="width: @((int)percentage)%; background: @(isLow ? "#ef4444" : "var(--primary-grad)")"></div>
                                </div>

                                <div class="action-zone">
                                    <div class="quick-actions">
                                        <button type="button" class="btn-qty" onclick="addQty('@item.IdIngredient', 1)">-1</button>
                                        <button type="button" class="btn-qty" onclick="addQty('@item.IdIngredient', 5)">-5</button>
                                    </div>
                                    <form asp-action="ConsommerIngredient" method="post">
                                        <input type="hidden" name="id" value="@item.IdIngredient" />
                                        <input type="number" name="quantiteUtilisee" id="input-@item.IdIngredient"
                                               step="0.1" class="form-control qty-input-modern shadow-none" placeholder="Quantité à retirer" required />
                                        <button type="submit" class="btn btn-submit-modern">
                                            <i class="fa-solid fa-minus-circle me-2"></i>Utiliser l'ingrédient
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        function addQty(id, val) {
            const input = document.getElementById('input-' + id);
            input.value = val;
        }
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

</body>
</html>