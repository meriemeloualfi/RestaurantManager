@model IEnumerable<Ingredient>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.QuantiteDisponible)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Unite)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SeuilAlerte)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Stock)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.QuantiteDisponible)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Unite)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SeuilAlerte)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Stock.IdStock)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdIngredient">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdIngredient">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdIngredient">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
