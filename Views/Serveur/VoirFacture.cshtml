@model RestaurantManager.Models.Facture
@{
    Layout = null;
    // Détection du rôle pour adapter l'interface
    bool estGerant = User.IsInRole("Gerant");
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Facture #@Model.IdFacture | Food Dash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-orange: #ff7b2e;
            --dark-blue: #1e293b;
            --light-bg: #f8fafc;
        }

        body {
            background-color: var(--light-bg);
            font-family: 'Poppins', sans-serif;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 280px;
            background: var(--dark-blue);
            color: white;
            padding: 40px 20px;
            position: fixed;
            height: 100vh;
            z-index: 1000;
            display: flex;
            flex-direction: column;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.7);
                padding: 12px 20px;
                border-radius: 12px;
                margin-bottom: 8px;
                display: flex;
                align-items: center;
                text-decoration: none;
                transition: 0.3s;
            }

                .sidebar .nav-link i {
                    margin-right: 15px;
                    width: 20px;
                    text-align: center;
                }

                .sidebar .nav-link:hover, .sidebar .nav-link.active {
                    background: var(--primary-orange);
                    color: white;
                    box-shadow: 0 4px 15px rgba(255, 123, 46, 0.3);
                }

        .main-content {
            flex-grow: 1;
            margin-left: 280px;
            padding: 40px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
        }

        .text-orange-resto {
            color: var(--primary-orange);
        }

        .receipt-card {
            background: white;
            width: 420px;
            padding: 40px;
            border-radius: 0;
            box-shadow: 0 15px 35px rgba(0,0,0,0.08);
            border-top: 8px solid var(--primary-orange);
            position: relative;
        }

            .receipt-card::after {
                content: "";
                position: absolute;
                bottom: -10px;
                left: 0;
                width: 100%;
                height: 10px;
                background: linear-gradient(-45deg, transparent 5px, white 5px), linear-gradient(45deg, transparent 5px, white 5px);
                background-size: 10px 10px;
            }

        .dotted-line {
            border-top: 2px dotted #e2e8f0;
            margin: 20px 0;
        }

        @@media print {
            .sidebar, .no-print {
                display: none !important;
            }

            .main-content {
                margin-left: 0 !important;
                padding: 0;
            }

            .receipt-card {
                box-shadow: none;
                border: 1px solid #eee;
                margin: 0 auto;
            }
        }
    </style>
</head>
<body>

    <div class="admin-wrapper">
        <!-- SIDEBAR DYNAMIQUE -->
        <div class="sidebar">
            <h3 class="fw-bold mb-5">Food Dash <span class="text-orange-resto">.</span> </h3>
            <nav class="nav flex-column h-100">

                @if (estGerant)
                {
                    <!-- Menu pour le Gérant -->
                    <a class="nav-link" href="/Gerant"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                    <a class="nav-link" href="/Plats"><i class="fa-solid fa-burger"></i> Menu / Plats</a>
                    <a class="nav-link" href="/Employes"><i class="fa-solid fa-users"></i> Personnel</a>
                    <a class="nav-link" href="/Reservations"><i class="fa-solid fa-calendar-check"></i> Réservations</a>
                    <a class="nav-link" href="/Stocks"><i class="fa-solid fa-box"></i> Stocks</a>
                    <a class="nav-link active" href="/Ventes"><i class="fa-solid fa-chart-line"></i> Ventes</a>
                }
                else
                {
                    <!-- Menu pour le Serveur -->
                    <a class="nav-link" asp-controller="Serveur" asp-action="Index"><i class="fa-solid fa-house"></i> Dashboard</a>
                    <a class="nav-link" asp-controller="Serveur" asp-action="PrendreCommande"><i class="fa-solid fa-plus-circle"></i> Prendre Commande</a>
                    <a class="nav-link" asp-controller="Serveur" asp-action="ListeReservations"><i class="fa-solid fa-calendar-check"></i> Réservations</a>
                    <a class="nav-link" asp-controller="Serveur" asp-action="MesTaches"><i class="fa-solid fa-list-check"></i> Mes Tâches</a>
                    <a class="nav-link active" asp-controller="Serveur" asp-action="MesVentes"><i class="fa-solid fa-receipt"></i> Mes Ventes</a>
                }

                <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="margin-top: auto; padding-bottom: 20px;">
                    <button type="submit" class="nav-link bg-transparent border-0 text-danger w-100 text-start">
                        <i class="fa-solid fa-power-off"></i> Déconnexion
                    </button>
                </form>
            </nav>
        </div>

        <div class="main-content">
            <div class="receipt-card">
                <div class="text-center mb-4">
                    <h3 class="fw-bold mb-0">FOOD DASH</h3>
                    <small class="text-muted">Cuisine & Passion</small>

                    <div class="mt-3">
                        @if (Model.Vente.Commande.NumeroTable.HasValue)
                        {
                            <span class="badge bg-dark rounded-pill px-3 py-2">TABLE @Model.Vente.Commande.NumeroTable</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2">À EMPORTER</span>
                        }
                    </div>
                </div>

                <div class="dotted-line"></div>

                <div class="small text-muted mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Date :</span>
                        <span class="text-dark fw-bold">@Model.DateEmission.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Ticket :</span>
                        <span class="text-dark fw-bold">#@Model.IdFacture</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span>Serveur :</span>
                        <span class="text-dark fw-bold">@ViewBag.NomServeur</span>
                    </div>
                </div>

                <div class="dotted-line"></div>

                <table class="table table-borderless table-sm mb-0">
                    <thead>
                        <tr class="small text-muted border-bottom">
                            <th class="ps-0">Article</th>
                            <th class="text-end pe-0">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Vente.Commande.PlatsCommandes)
                        {
                            <tr>
                                <td class="ps-0 pt-3">
                                    <span class="fw-bold">@item.Quantite x</span> @item.Plat.Nom
                                    @if (!string.IsNullOrEmpty(item.NoteSpecial))
                                    {
                                        <div class="small text-muted italic" style="font-size: 0.75rem;">└ @item.NoteSpecial</div>
                                    }
                                </td>
                                <td class="text-end pe-0 pt-3 fw-bold">@(item.PrixUnitaire* item.Quantite) DH</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="dotted-line"></div>

                <div class="small mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Montant Brut :</span>
                        <span class="fw-bold">@Model.Vente.MontantBrut.ToString("N2") DH</span>
                    </div>

                    @if (Model.Vente.Remise > 0)
                    {
                        <div class="d-flex justify-content-between mb-1 text-danger">
                            <span>Remise :</span>
                            <span class="fw-bold">- @Model.Vente.Remise.ToString("N2") DH</span>
                        </div>
                    }
                </div>

                <div class="dotted-line"></div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="h5 fw-bold mb-0">TOTAL FINAL</span>
                    <span class="h3 fw-bold mb-0 text-orange-resto">@Model.Montant.ToString("N2") DH</span>
                </div>

                <div class="text-center no-print mt-4">
                    <p class="small text-muted mb-4 italic">Merci de votre visite !</p>
                    <div class="d-grid gap-2">
                        <button onclick="window.print()" class="btn btn-dark rounded-pill py-3 fw-bold">
                            <i class="fa-solid fa-print me-2"></i> IMPRIMER LE TICKET
                        </button>

                        @if (estGerant)
                        {
                            <a href="/Ventes" class="btn btn-outline-secondary rounded-pill py-2 border-0">
                                <i class="fa-solid fa-arrow-left me-2"></i> Retour aux Ventes
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Serveur" asp-action="PrendreCommande" class="btn btn-outline-secondary rounded-pill py-2 border-0">
                                <i class="fa-solid fa-plus-circle me-2"></i> Nouvelle Commande
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>