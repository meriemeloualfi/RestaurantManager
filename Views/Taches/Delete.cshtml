@model RestaurantManager.Models.Tache

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supprimer Mission | Food Dash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f8fafc;
            font-family: 'Poppins', sans-serif;
        }

        .main-content {
            background-color: #f4f7fa;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: 20px;
        }

        .delete-card-res {
            background: white;
            border-radius: 35px;
            padding: 60px 40px 40px;
            text-align: center;
            max-width: 550px;
            width: 100%;
            border: 1px solid #fee2e2;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);
            position: relative;
        }

        .trash-icon-float {
            width: 90px;
            height: 90px;
            background: #ef4444;
            color: white;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            position: absolute;
            top: -45px;
            left: 50%;
            transform: translateX(-50%) rotate(-10deg);
            box-shadow: 0 15px 30px rgba(239, 68, 68, 0.3);
            border: 6px solid #fef2f2;
            z-index: 10;
        }

        .res-info-box {
            background: #f8fafc;
            border-radius: 24px;
            padding: 25px;
            margin: 30px 0;
            text-align: left;
            border: 1px solid #e2e8f0;
        }

        .res-header-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            border-bottom: 1px dashed #cbd5e1;
            padding-bottom: 15px;
        }

        .task-title-bold {
            font-size: 1.2rem;
            font-weight: 700;
            color: #1e293b;
        }

        .details-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .detail-item {
            font-size: 0.95rem;
            color: #64748b;
            display: flex;
            align-items: center;
        }

            .detail-item i {
                color: #ff7b2e;
                width: 30px;
                font-size: 1.1rem;
            }

        .btn-confirm-delete {
            background: #ef4444;
            color: white;
            border: none;
            width: 100%;
            padding: 16px;
            border-radius: 18px;
            font-weight: 700;
            font-size: 1.1rem;
            transition: 0.3s;
            margin-bottom: 15px;
            box-shadow: 0 10px 20px rgba(239, 68, 68, 0.2);
            text-decoration: none;
            display: inline-block;
        }

            .btn-confirm-delete:hover {
                background: #dc2626;
                transform: translateY(-3px);
                box-shadow: 0 15px 30px rgba(239, 68, 68, 0.3);
                color: white;
            }

        .btn-back-link {
            color: #94a3b8;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

            .btn-back-link:hover {
                color: #1e293b;
            }
    </style>
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h3 class="fw-bold mb-5">Food Dash <span class="text-orange-resto">.</span> </h3>
            <nav class="nav flex-column">
                <a class="nav-link" href="/Gerant"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a class="nav-link" href="/Plats"><i class="fa-solid fa-burger"></i> Menu / Plats</a>
                <a class="nav-link active" href="/Employes"><i class="fa-solid fa-users"></i> Personnel</a>
                <a class="nav-link" href="/Reservations"><i class="fa-solid fa-calendar-check"></i> Réservations</a>
                <a class="nav-link" href="/Stocks"><i class="fa-solid fa-box"></i> Stocks</a>
                <a class="nav-link" href="/Ventes"><i class="fa-solid fa-chart-line"></i> Ventes</a>
                <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="margin-top: 100px;">
                    <button type="submit" class="nav-link bg-transparent border-0 text-danger w-100 text-start">
                        <i class="fa-solid fa-power-off"></i> Déconnexion
                    </button>
                </form>
            </nav>
        </div>

        <div class="main-content">
            <div class="delete-card-res shadow-lg">
                <!-- Icône flottante (Style Mission/Poubelle) -->
                <div class="trash-icon-float">
                    <i class="fa-solid fa-clipboard-question"></i>
                </div>

                <h2 class="fw-bold mt-4">Supprimer la mission ?</h2>
                <p class="text-muted px-3">Cette action retirera la tâche de la feuille de route de l'employé.</p>

                <!-- Résumé de la Tâche -->
                <div class="res-info-box">
                    <div class="res-header-info">
                        <span class="task-title-bold">@Model.Description</span>
                        <span class="badge @(Model.EstTerminee ? "bg-success" : "bg-warning") rounded-pill px-3 py-2">
                            @(Model.EstTerminee ? "Terminée" : "En cours")
                        </span>
                    </div>

                    <div class="details-grid">
                        <div class="detail-item">
                            <i class="fa-solid fa-user-tag"></i>
                            <span>Assigné à : <strong>@Model.Employe.Nom</strong></span>
                        </div>
                        <div class="detail-item">
                            <i class="fa-solid fa-calendar-day"></i>
                            <span>Échéance : @Model.DateFin.ToString("dd MMMM yyyy")</span>
                        </div>
                        <div class="detail-item">
                            <i class="fa-solid fa-clock"></i>
                            <span>Heure limite : @Model.DateFin.ToString("HH:mm")</span>
                        </div>
                    </div>
                </div>

                <!-- Formulaire de suppression réelle -->
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdTache" />
                    <button type="submit" class="btn-confirm-delete">
                        <i class="fa-solid fa-trash-can me-2"></i> CONFIRMER LA SUPPRESSION
                    </button>
                </form>

                <a href="/Employes/Details/@Model.EmployeId" class="btn-back-link">
                    ANNULER ET REVENIR AU PROFIL
                </a>
            </div>
        </div>
    </div>
</body>
</html>