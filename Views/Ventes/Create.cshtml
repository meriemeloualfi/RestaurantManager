@model RestaurantManager.Models.Vente

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Encaisser Vente | Food Dash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --orange-dash: #ff7b2e;
            --navy-dash: #1e293b;
            --bg-soft: #f4f7fa;
        }

        body {
            background-color: var(--bg-soft);
            font-family: 'Poppins', sans-serif;
            margin: 0;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            width: 280px;
            background: var(--navy-dash);
            padding: 40px 24px;
            display: flex;
            flex-direction: column;
            position: sticky;
            top: 0;
            height: 100vh;
            color: white;
        }

            .sidebar h3 {
                font-weight: 700;
                margin-bottom: 50px;
                padding-left: 15px;
            }

        .nav-link {
            color: rgba(255,255,255,0.7);
            font-weight: 500;
            padding: 14px 20px;
            border-radius: 16px;
            margin-bottom: 8px;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
        }

            .nav-link.active {
                background: var(--orange-dash);
                color: white;
                box-shadow: 0 10px 20px rgba(255, 123, 46, 0.2);
            }

            .nav-link:hover:not(.active) {
                background: rgba(255,255,255,0.1);
                color: white;
            }

        /* --- MAIN CONTENT --- */
        .main-content {
            flex-grow: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        /* --- CARD DESIGN --- */
        .premium-card {
            background: white;
            border-radius: 45px;
            padding: 70px 45px 45px;
            max-width: 550px;
            width: 100%;
            box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.1);
            position: relative;
            text-align: center;
        }

        .icon-badge-top {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--orange-dash), #ff9d66);
            color: white;
            border-radius: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.8rem;
            position: absolute;
            top: -50px;
            left: 50%;
            transform: translateX(-50%) rotate(10deg);
            box-shadow: 0 20px 40px rgba(255, 123, 46, 0.3);
            border: 8px solid white;
        }

        h2 {
            color: var(--navy-dash);
            font-weight: 800;
            margin-bottom: 10px;
        }

        .sub-text {
            color: #94a3b8;
            font-size: 0.9rem;
            margin-bottom: 40px;
        }

        /* --- INPUTS --- */
        .form-label {
            display: block;
            text-align: left;
            font-size: 0.8rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-left: 10px;
            margin-bottom: 8px;
        }

        .input-group-wow {
            position: relative;
            margin-bottom: 25px;
        }

            .input-group-wow i {
                position: absolute;
                left: 22px;
                top: 48px;
                color: #cbd5e1;
                font-size: 1.1rem;
                z-index: 5;
            }

        .form-control-wow {
            width: 100%;
            padding: 16px 20px 16px 60px;
            border-radius: 22px;
            border: 2px solid #f1f5f9;
            background: #f8fafc;
            font-weight: 600;
            color: var(--navy-dash);
            transition: 0.3s;
            appearance: none; /* Pour le look du select */
        }

            .form-control-wow:focus {
                outline: none;
                border-color: var(--orange-dash);
                background: white;
                box-shadow: 0 10px 25px rgba(255, 123, 46, 0.1);
            }

        /* --- VALIDATION ERROR STYLE --- */
        .text-danger-custom {
            color: #ef4444;
            font-size: 0.75rem;
            font-weight: 600;
            display: block;
            text-align: left;
            margin-left: 15px;
            margin-top: 5px;
        }

        /* --- BUTTON --- */
        .btn-encaisser {
            background: var(--navy-dash);
            color: white;
            border: none;
            width: 100%;
            padding: 20px;
            border-radius: 25px;
            font-weight: 700;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            transition: 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 15px 30px rgba(30, 41, 59, 0.2);
            margin-top: 20px;
        }

            .btn-encaisser:hover {
                background: var(--orange-dash);
                transform: translateY(-5px);
                box-shadow: 0 20px 40px rgba(255, 123, 46, 0.3);
                color: white;
            }

        .btn-cancel {
            display: block;
            margin-top: 25px;
            color: #94a3b8;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>

    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h3 class="fw-bold">Food Dash <span style="color:var(--orange-dash)">.</span></h3>
            <nav class="nav flex-column">
                <a class="nav-link" href="/Gerant"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a class="nav-link" href="/Plats"><i class="fa-solid fa-burger"></i> Menu</a>
                <a class="nav-link" href="/Employes"><i class="fa-solid fa-users"></i> Personnel</a>
                <a class="nav-link" href="/Reservations"><i class="fa-solid fa-calendar-check"></i> Réservations</a>
                <a class="nav-link" href="/Stocks"><i class="fa-solid fa-box"></i> Stocks</a>
                <a class="nav-link active" href="/Ventes"><i class="fa-solid fa-chart-line"></i> Ventes</a>

                <form asp-area="Identity" asp-page="/Account/Logout" method="post" style="margin-top: auto; padding-bottom: 20px;">
                    <button type="submit" class="nav-link bg-transparent border-0 text-white w-100 text-start" style="opacity: 0.7;">
                        <i class="fa-solid fa-power-off"></i> Déconnexion
                    </button>
                </form>
            </nav>
        </div>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            <div class="premium-card shadow-lg">
                <div class="icon-badge-top">
                    <i class="fa-solid fa-cash-register"></i>
                </div>

                <h2>Nouvel Encaïssement</h2>
                <p class="sub-text">Enregistrez une vente manuelle dans le journal.</p>

                <!-- Résumé des erreurs globales -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-4 shadow-sm py-2 px-3 small mb-4"></div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="input-group-wow">
                        <label asp-for="CommandeId" class="form-label">Sélectionner la Commande</label>
                        <i class="fa-solid fa-hashtag"></i>
                        <select asp-for="CommandeId" class="form-control-wow" asp-items="ViewBag.CommandeId">
                            <option value="">-- Choisir une commande --</option>
                        </select>
                        <span asp-validation-for="CommandeId" class="text-danger-custom"></span>
                    </div>

                    <div class="input-group-wow">
                        <label asp-for="MontantBrut" class="form-label">Montant de la commande (DH)</label>
                        <i class="fa-solid fa-coins"></i>
                        <input asp-for="MontantBrut" class="form-control-wow" placeholder="0.00" type="number" step="0.01" required />
                        <span asp-validation-for="MontantBrut" class="text-danger-custom"></span>
                    </div>

                    <div class="input-group-wow">
                        <label asp-for="Remise" class="form-label">Remise / Promotion (DH)</label>
                        <i class="fa-solid fa-tag"></i>
                        <input asp-for="Remise" class="form-control-wow" placeholder="0.00" type="number" step="0.01" />
                        <span asp-validation-for="Remise" class="text-danger-custom"></span>
                    </div>

                    <button type="submit" class="btn-encaisser">
                        VALIDER ET FACTURER <i class="fa-solid fa-check"></i>
                    </button>
                </form>

                <a href="/Ventes" class="btn-cancel">
                    <i class="fa-solid fa-chevron-left me-2"></i> Annuler
                </a>
            </div>
        </div>
    </div>

</body>
</html>