@model RestaurantManager.Models.Plat

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modifier Plat - Food Dash</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* --- CONFIGURATION SIDEBAR (DECONNEXION EN BAS) --- */
        .sidebar {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            padding-bottom: 20px;
        }

            .sidebar nav {
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }

        .logout-section {
            margin-top: auto; /* Pousse vers le bas */
            padding-top: 20px;
            border-top: 1px solid rgba(0,0,0,0.05);
        }

        .btn-logout {
            color: #dc3545 !important;
            font-weight: 600;
            transition: all 0.2s ease;
            padding: 10px 15px;
            border-radius: 8px;
            width: 100%;
        }

            .btn-logout:hover {
                background-color: #fff5f5 !important;
                color: #a52834 !important;
            }

        /* --- STYLES DE LA PAGE --- */
        .main-content {
            background-color: #f4f7fa;
        }

        .edit-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .master-card-edit {
            background: white;
            border-radius: 24px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            overflow: hidden;
        }

        .edit-header {
            padding: 35px 50px;
            background: #ffffff;
            border-bottom: 1px solid #f1f5f9;
        }

            .edit-header h2 {
                font-weight: 700;
                color: #0f172a;
                margin: 0;
            }

        .edit-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 0;
        }

        .form-section {
            padding: 50px;
            border-right: 1px solid #f1f5f9;
        }

        .preview-section {
            padding: 50px;
            background-color: #fafbfc;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }

        .custom-input {
            border-radius: 12px;
            padding: 12px 18px;
            border: 1px solid #e2e8f0;
            background-color: #f8fafc;
            transition: 0.3s;
        }

            .custom-input:focus {
                background-color: #fff;
                border-color: #ff7b2e;
                box-shadow: 0 0 0 4px rgba(255, 123, 46, 0.1);
                outline: none;
            }

        .current-image-wrapper {
            width: 100%;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            margin-bottom: 25px;
        }

            .current-image-wrapper img {
                width: 100%;
                height: 250px;
                object-fit: cover;
            }

        .edit-actions {
            padding: 30px 50px;
            background: #ffffff;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-save-pro {
            background: #0f172a;
            color: white;
            padding: 14px 40px;
            border-radius: 14px;
            font-weight: 600;
            border: none;
            transition: 0.3s;
            cursor: pointer;
        }

            .btn-save-pro:hover {
                background: #1e293b;
                transform: translateY(-2px);
            }

        .btn-cancel-pro {
            color: #64748b;
            text-decoration: none;
            font-weight: 600;
            transition: 0.2s;
        }

            .btn-cancel-pro:hover {
                color: #0f172a;
            }
    </style>
</head>
<body class="admin-body">
    <div class="admin-wrapper">
        <!-- SIDEBAR -->
        <div class="sidebar">
            <h3 class="fw-bold mb-5">Food Dash <span class="text-orange-resto">.</span> </h3>
            <nav class="nav flex-column">
                <a class="nav-link" href="/Gerant"><i class="fa-solid fa-chart-pie me-2"></i> Dashboard</a>
                <a class="nav-link active" href="/Plats"><i class="fa-solid fa-burger me-2"></i> Menu / Plats</a>
                <a class="nav-link" href="/Employes"><i class="fa-solid fa-users me-2"></i> Personnel</a>
                <a class="nav-link" href="/Reservations"><i class="fa-solid fa-calendar-check me-2"></i> Réservations</a>
                <a class="nav-link" href="/Stocks"><i class="fa-solid fa-box me-2"></i> Stocks</a>
                <a class="nav-link" href="/Ventes"><i class="fa-solid fa-chart-line me-2"></i> Ventes</a>

                <!-- SECTION DECONNEXION POUSSÉE EN BAS -->
                <div class="logout-section">
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                        <button type="submit" class="bg-transparent border-0 btn-logout text-start">
                            <i class="fa-solid fa-power-off me-2"></i> Déconnexion
                        </button>
                    </form>
                </div>
            </nav>
        </div>

        <div class="main-content">
            <div class="edit-container">
                <div class="mb-4">
                    <a asp-action="Index" class="text-muted text-decoration-none small fw-bold">
                        <i class="fa-solid fa-chevron-left me-1"></i> Retour à la liste
                    </a>
                </div>

                <div class="master-card-edit">
                    <div class="edit-header">
                        <h2>Modifier les informations du <span class="text-orange-resto">Plat</span></h2>
                    </div>

                    <form asp-action="Edit" enctype="multipart/form-data" id="editForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input type="hidden" asp-for="IdPlat" />
                        <input type="hidden" asp-for="ImagePath" />

                        <div class="edit-grid">
                            <div class="form-section">
                                <div class="mb-4">
                                    <label asp-for="Nom" class="form-label">Nom du plat</label>
                                    <input asp-for="Nom" class="form-control custom-input" />
                                    <span asp-validation-for="Nom" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Prix" class="form-label">Prix de vente (DH)</label>
                                    <input asp-for="Prix" class="form-control custom-input" type="number" step="0.01" />
                                    <span asp-validation-for="Prix" class="text-danger small"></span>
                                </div>

                                <div class="mb-0">
                                    <label asp-for="Description" class="form-label">Description détaillée</label>
                                    <textarea asp-for="Description" class="form-control custom-input" rows="5"></textarea>
                                    <span asp-validation-for="Description" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="preview-section">
                                <label class="form-label">Image actuelle</label>
                                <div class="current-image-wrapper">
                                    @if (!string.IsNullOrEmpty(Model.ImagePath))
                                    {
                                        <img src="~/images/plats/@Model.ImagePath" alt="Aperçu" id="imgPreview" />
                                    }
                                    else
                                    {
                                        <img src="https://via.placeholder.com/400x300?text=Aucune+Image" id="imgPreview" />
                                    }
                                </div>

                                <label class="form-label">Remplacer l'image</label>
                                <input type="file" name="imageFile" class="form-control border-0 bg-transparent p-0" accept="image/*" onchange="previewImage(this)" />
                            </div>
                        </div>

                        <div class="edit-actions">
                            <a asp-action="Index" class="btn-cancel-pro">Annuler</a>
                            <button type="submit" class="btn-save-pro shadow-lg">
                                <i class="fa-solid fa-check me-2"></i> Enregistrer les changements
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imgPreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
</body>
</html>