@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="container mt-5 text-center">
    <div class="spinner-border text-warning" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <p class="mt-3">Déconnexion en cours, veuillez patienter...</p>
</div>

@section Scripts {
    <script>
        // Si le serveur n'a pas redirigé, on force le clic sur le bouton caché
        // ou on redirige vers l'accueil au bout de 100ms
        window.onload = function () {
            window.location.href = "/";
        };
    </script>
}