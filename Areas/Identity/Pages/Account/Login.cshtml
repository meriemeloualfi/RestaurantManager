@page
@model LoginModel

@{
    ViewData["Title"] = "Connexion";
}

<style>
    :root {
        --restaurant-orange: #e67e22;
        --restaurant-orange-hover: #d35400;
    }

    /* --- NAVBAR (Logo Orange, Liens Blancs) --- */
    .navbar-brand {
        color: var(--restaurant-orange) !important;
        font-weight: 800 !important;
    }

    .navbar-nav .nav-link {
        color: white !important;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.3);
    }

    /* --- FOOTER (Texte Blanc) --- */
    footer, footer span, footer a, .footer, footer .text-muted {
        color: white !important;
        background: transparent !important;
        border: none !important;
    }

        footer a {
            text-decoration: underline !important;
        }

    /* --- FOND FLOU --- */
    .auth-bg-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background-image: url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
        background-size: cover;
        background-position: center;
        filter: blur(15px) brightness(0.6);
        transform: scale(1.1);
    }

    .main-container {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* --- CARTE LOGIN --- */
    .login-card {
        background: white;
        border-radius: 30px;
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
        overflow: hidden;
        max-width: 950px;
        width: 95%;
        display: flex;
    }

    .login-side-img {
        background-image: url('https://images.unsplash.com/photo-1559339352-11d035aa65de?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80');
        background-size: cover;
        background-position: center;
        width: 48%;
    }

    .login-form-side {
        padding: 60px;
        flex: 1;
    }

    /* --- SOLUTION : ÉLIMINER LE FOND BLANC DU FORM-FLOATING --- */
    .form-floating {
        background: transparent !important;
    }

        .form-floating > .form-control {
            background-color: #f1f3f6 !important; /* Gris très clair pour le champ */
            border: none !important;
            border-radius: 12px !important;
            height: 70px !important;
            padding-top: 1.7rem !important;
            box-shadow: none !important;
        }

        /* Supprime le fond blanc derrière le label */
        .form-floating > label {
            background-color: transparent !important;
            padding: 1.3rem 1rem !important;
            color: #7f8c8d !important;
        }

        /* Supprime le rectangle blanc spécifique de Bootstrap 5 qui apparaît quand on clique */
        .form-floating > .form-control:focus ~ label::after,
        .form-floating > .form-control:not(:placeholder-shown) ~ label::after {
            background-color: transparent !important;
        }

        /* Style du label quand il est en haut */
        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            transform: scale(0.85) translateY(-0.85rem) translateX(0.15rem) !important;
            color: var(--restaurant-orange) !important;
            background: transparent !important;
            font-weight: 700;
            opacity: 1;
        }

    /* Empêche le bleu de l'autofill de Chrome */
    input:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 50px #f1f3f6 inset !important;
        -webkit-text-fill-color: #2c3e50 !important;
    }

    /* --- BOUTON --- */
    .btn-orange {
        background-color: var(--restaurant-orange);
        border: none;
        border-radius: 15px;
        padding: 15px;
        font-weight: 700;
        color: white !important;
        transition: 0.3s;
    }

        .btn-orange:hover {
            background-color: var(--restaurant-orange-hover);
            transform: translateY(-2px);
        }

    .link-orange {
        color: var(--restaurant-orange) !important;
        font-weight: 700;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .login-side-img {
            display: none;
        }

        .login-form-side {
            padding: 40px 20px;
        }
    }
</style>

<div class="auth-bg-wrapper"></div>

<div class="container main-container">
    <div class="login-card">
        <div class="login-side-img"></div>
        <div class="login-form-side">
            <h2 class="text-center fw-bold mb-1" style="color: #2c3e50;">Bienvenue !</h2>
            <p class="text-muted text-center mb-5">Prêt pour une expérience culinaire ?</p>

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" autocomplete="off" />
                    <label asp-for="Input.Email">Adresse Email</label>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.Password" class="form-control" placeholder="Mot de passe" />
                    <label asp-for="Input.Password">Mot de passe</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-5">
                    <div class="form-check">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label text-muted" asp-for="Input.RememberMe">Se souvenir</label>
                    </div>
                    <a id="forgot-password" asp-page="./ForgotPassword" class="link-orange">Oublié ?</a>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn-orange shadow-sm">S'identifier</button>

                <div class="text-center mt-4">
                    <p class="small text-muted">
                        Pas encore de compte ?
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-dark text-decoration-none">Créer un compte</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}